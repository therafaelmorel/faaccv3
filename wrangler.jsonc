{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "faaccv3",
  "main": "./src/worker.js",
  "compatibility_date": "2026-08-09",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fact-prototype",
      "database_id": "0de54027-2db4-4c48-9f90-da699607fd06",
      "migrations_dir": "./migrations"
    }
  ],
  "vars": {
    "BUILD_MODE": "true",
    "FEEDBACK_ENABLED": "true",
    "ADMIN_ROLE_PREVIEW_ENABLED": "true"
  },
  "observability": {
    "enabled": true
  }
}
